set -eu

if [ -n "${SKIP_AURORA_HOOKS:-}" ]; then
  exit 0
fi
hook_root=$(git rev-parse --show-toplevel)
cd "$hook_root"
git diff --cached --check
# CI runs the full Java, UI, agent and packaging gates on committed inputs.
exec build-support/bootstrap-go check-tools
