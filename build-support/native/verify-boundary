"""Verify the actual isolated native Java runtime, including renamed/repacked code."""

import argparse
import hashlib
import json
import os
from pathlib import Path, PurePosixPath
import re
import struct
import sys
import tempfile
import zipfile

EXTERNAL = {
    "jackson-annotations-2.22.jar": "21ddb598807d3a51a876704eb979d9296e1c6a6f47ab1826ff88c6d6a127a2d0",
    "jackson-core-2.22.2.jar": "ff167a6317be15895706c26668f45b898efe40ab8780970658210fe1393d52a6",
    "jackson-databind-2.22.2.jar": "d0da14c12b16b5d54719aa172d83b542ff4abeb8b0fb7db476fde8ceece760ca",
    "json-schema-validator-2.0.7.jar": "7d01cefd6f0d656666b94778c7a13ada2941aace48e76830809c0dbf61ad5be2",
    "slf4j-api-2.0.19.jar": "e91ff6d720609e7a194ffe758c3ed5c84e798617ae07b0a0f6a4fe229741b4bb",
    "slf4j-nop-2.0.19.jar": "d0226062f9b3a2793f62002f892a8e624eb07f396130fc949e01b1d5f4888cba",
    "sqlite-jdbc-3.53.4.0.jar": "bcb1f51e36f940867e83342f9efbf5968ac44a6bef4d397bb4af7b17b45cd2fb",
}
# Keep the artifact source identity alongside the exact content allowlist.
COORDINATES = {
    name: ("com.fasterxml.jackson.core:" if name.startswith("jackson-") else
           "com.networknt:" if name.startswith("json-schema-") else
           "org.slf4j:" if name.startswith("slf4j-") else "org.xerial:")
    + name[:-4].rsplit("-", 1)[0] + ":" + name[:-4].rsplit("-", 1)[1]
    for name in EXTERNAL
}
SQLITE = "sqlite-jdbc-3.53.4.0.jar"
NATIVE_CLASS = re.compile(
    r"org/apache/aurora/(?:nativescheduler/(?:Json|NativeConfig|NativeDaemon|NativeEngine|NativePolicy|NativeSchedulerMain)"
    r"|scheduler/storage/sql/NativeSqlStore)(?:\$[A-Za-z0-9_$]+)?\Z")
PROTOCOL_CLASS = re.compile(
    r"org/apache/aurora/nativeprotocol/(?:ProtocolValidator|ProtocolTool)(?:\$[A-Za-z0-9_$]+)?\Z")
FORBIDDEN = (
    "org/apache/mesos", "org/apache/zookeeper", "org/apache/curator",
    "org/apache/aurora/executor", "org/apache/aurora/thermos",
    "apache/aurora/executor", "apache/thermos", "apache/aurora/worker",
    "pythonworker", "python_worker", "nativestoretool",
)


class BoundaryError(Exception):
    """The runtime differs from the reviewed native boundary."""


def require(condition, message):
    if not condition:
        raise BoundaryError(message)


def forbidden(value):
    normalized = value.lower().replace(".", "/")
    compact = value.lower()
    if any(term in normalized or term in compact for term in FORBIDDEN):
        return True
    # Descriptors and reflection strings can name a class without CONSTANT_Class.
    for match in re.finditer(r"org/apache/aurora/[A-Za-z0-9_$/]+", value.replace(".", "/")):
        identity = match.group(0)
        if not NATIVE_CLASS.fullmatch(identity) and not PROTOCOL_CLASS.fullmatch(identity):
            return True
    return False


def class_info(data):
    """Parse JVM constant pool rather than trusting a ZIP entry's filename."""
    require(len(data) >= 10 and data[:4] == b"\xca\xfe\xba\xbe", "invalid class magic")
    require(struct.unpack_from(">H", data, 4)[0] == 0, "preview or legacy minor class version forbidden")
    major, count = struct.unpack_from(">HH", data, 6)
    offset, index = 10, 1
    pool, strings, references = {}, [], []

    def take(size):
        nonlocal offset
        require(offset + size <= len(data), "truncated class constant pool")
        result = data[offset:offset + size]
        offset += size
        return result

    while index < count:
        tag = take(1)[0]
        if tag == 1:
            size = struct.unpack(">H", take(2))[0]
            # Accept Java's modified-null and surrogate encoding, but reject
            # malformed/overlong ASCII that could conceal a package reference.
            encoded = take(size).replace(b"\xc0\x80", b"\x00")
            try:
                text = encoded.decode("utf-8", errors="surrogatepass")
            except UnicodeDecodeError as error:
                raise BoundaryError("invalid modified UTF-8 class constant") from error
            pool[index] = text
            strings.append(text)
        elif tag == 7:
            target = struct.unpack(">H", take(2))[0]
            pool[index] = target
            references.append(target)
        elif tag in (3, 4, 9, 10, 11, 12, 17, 18):
            take(4)
        elif tag in (5, 6):
            take(8)
            index += 1
        elif tag in (8, 16, 19, 20):
            take(2)
        elif tag == 15:
            take(3)
        else:
            raise BoundaryError("unknown class constant-pool tag")
        index += 1
    _, this_class = struct.unpack(">HH", take(4))
    name = pool.get(pool.get(this_class))
    require(isinstance(name, str), "invalid class identity")
    require(all(isinstance(pool.get(ref), str) for ref in references), "invalid class reference")
    require(not any(forbidden(value) for value in strings), "forbidden class reference: " + name)
    return name, major, [pool[ref] for ref in references]


def inspect_jar(path, own_kind=None, java_profile="java25"):
    require(java_profile in ("java25", "java26-runtime", "java26"), "Unknown Java profile")
    expected_major = 70 if java_profile == "java26" else 69
    classes, reference_count, native_count = [], 0, 0
    try:
        with zipfile.ZipFile(path) as archive:
            entries = archive.infolist()
            require(len(entries) <= 30000, "excessive JAR entries")
            seen = set()
            total = 0
            for entry in entries:
                name = entry.filename
                require(name not in seen, "duplicate JAR entry: " + name)
                seen.add(name)
                require(not name.startswith("/") and "\\" not in name
                        and ".." not in PurePosixPath(name).parts, "unsafe JAR entry")
                require(not any(term in name.lower().replace(".", "/") or term in name.lower()
                                for term in FORBIDDEN), "forbidden JAR entry: " + name)
                require(not name.lower().endswith((".py", ".pyc", ".pyo", ".jar")),
                        "worker or nested archive in runtime: " + name)
                require(not entry.flag_bits & 1 and (entry.external_attr >> 16) & 0o170000 != 0o120000,
                        "encrypted/symlink JAR entry")
                if entry.is_dir():
                    continue
                total += entry.file_size
                require(entry.file_size <= 32 * 1024 * 1024 and total <= 128 * 1024 * 1024,
                        "JAR decompression limit")
                if name.endswith(".class"):
                    identity, major, refs = class_info(archive.read(entry))
                    logical_name = re.sub(r"^META-INF/versions/[0-9]+/", "", name)[:-6]
                    require(logical_name == identity, "class name differs from archive entry")
                    if own_kind:
                        allowed = NATIVE_CLASS if own_kind == "scheduler" else PROTOCOL_CLASS
                        require(allowed.fullmatch(identity) is not None, "unexpected own runtime class: " + identity)
                        require(major == expected_major, "own runtime class has wrong reviewed Java target")
                        # A native class may not reach other legacy Aurora packages
                        # through descriptors, literals, or CONSTANT_Class entries.
                        for ref in refs:
                            if ref.startswith("org/apache/aurora/"):
                                require(NATIVE_CLASS.fullmatch(ref) is not None
                                        or PROTOCOL_CLASS.fullmatch(ref) is not None,
                                        "legacy Aurora class reference: " + ref)
                    classes.append(identity)
                    reference_count += len(refs)
                elif own_kind:
                    require(name == "META-INF/MANIFEST.MF"
                            or own_kind == "protocol" and name == "schema.json",
                            "unexpected own runtime resource: " + name)
                elif name.lower().endswith((".so", ".dll", ".dylib", ".jnilib")):
                    require(path.name == SQLITE and name.startswith("org/sqlite/native/"),
                            "unreviewed native library")
                    native_count += 1
            if own_kind == "scheduler":
                require("org/apache/aurora/nativescheduler/NativeSchedulerMain" in classes,
                        "scheduler main class missing")
                require("org/apache/aurora/scheduler/storage/sql/NativeSqlStore" in classes,
                        "SQL core class missing")
            elif own_kind == "protocol":
                require("org/apache/aurora/nativeprotocol/ProtocolValidator" in classes,
                        "protocol validator missing")
                require("schema.json" in seen, "native protocol schema missing")
    except (zipfile.BadZipFile, RuntimeError, EOFError, struct.error) as error:
        raise BoundaryError("invalid JAR: " + path.name) from error
    return {"classCount": len(classes), "classReferenceCount": reference_count,
            "nativeLibraryCount": native_count,
            **({"classes": sorted(classes)} if own_kind else {})}


def verify(lib_dir, profile="scheduler", java_profile="java25"):
    require(java_profile in ("java25", "java26-runtime", "java26"), "Unknown Java profile")
    directory = Path(lib_dir)
    require(directory.is_absolute() and directory.is_dir() and directory.resolve() == directory,
            "lib-dir must be an absolute real directory")
    files = list(directory.iterdir())
    require(all(path.is_file() and not path.is_symlink() and path.suffix == ".jar" for path in files),
            "runtime lib directory contains non-JAR or symlink")
    expected = dict(EXTERNAL)
    if profile == "protocol":
        del expected[SQLITE]
    names = {path.name for path in files}
    protocol_names = names & {"protocol.jar", "aurora-native-protocol.jar"}
    require(len(protocol_names) == 1, "exactly one native protocol JAR required")
    own = {next(iter(protocol_names)): "protocol"}
    if profile == "scheduler":
        own["aurora-native-scheduler.jar"] = "scheduler"
    require(names == set(expected) | set(own), "missing or unexpected runtime JAR: "
            + ",".join(sorted(names ^ (set(expected) | set(own)))))
    report = {"ok": True, "profile": profile, "javaTarget": 26 if java_profile == "java26" else 25, "javaProfile": java_profile, "jars": []}
    for path in sorted(files):
        digest = hashlib.sha256(path.read_bytes()).hexdigest()
        if path.name in expected:
            require(digest == expected[path.name], "external JAR SHA-256 mismatch: " + path.name)
        item = {"name": path.name, "sha256": digest, "bytes": path.stat().st_size,
                "kind": "own" if path.name in own else "external"}
        if path.name in expected:
            item["coordinate"] = COORDINATES[path.name]
        item.update(inspect_jar(path, own.get(path.name), java_profile))
        report["jars"].append(item)
    return report


def write_report(path, report):
    destination = Path(path)
    require(destination.is_absolute(), "report must be absolute")
    require(not any(part.is_symlink() for part in (destination, *destination.parents)),
            "report symlink rejected")
    destination.parent.mkdir(parents=True, exist_ok=True)
    handle, temporary = tempfile.mkstemp(prefix=".boundary-", dir=destination.parent)
    try:
        with os.fdopen(handle, "w") as output:
            json.dump(report, output, sort_keys=True, indent=2)
            output.write("\n")
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, destination)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--lib-dir", required=True)
    parser.add_argument("--report", required=True)
    parser.add_argument("--profile", choices=("scheduler", "protocol"), default="scheduler")
    parser.add_argument("--java-profile", choices=("java25", "java26-runtime", "java26"), default="java25")
    args = parser.parse_args()
    try:
        report = verify(args.lib_dir, args.profile, args.java_profile)
    except (BoundaryError, OSError, ValueError) as error:
        write_report(args.report, {"ok": False, "profile": args.profile, "error": str(error)})
        print("Native runtime boundary rejected: " + str(error), file=sys.stderr)
        return 1
    write_report(args.report, report)
    print("Native runtime boundary verified: " + str(len(report["jars"])) + " JARs")
    return 0


if __name__ == "__main__":
    sys.exit(main())
