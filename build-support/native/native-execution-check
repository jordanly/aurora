"""Qualify opt-in supervisors and task execution in new owned two-agent labs."""
import argparse
import importlib.machinery
import importlib.util
import json
from pathlib import Path
import sys
import time

ROOT = Path(__file__).resolve().parents[2]


def load(name, path):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


check = load("execution_cluster_check", ROOT / "build-support/lab/cluster-check")
cluster = check.cluster


class ExecutionLab(cluster.Lab):
    def create_container(self, role, args, mounts, networks, publish=False):
        if role in cluster.NODES:
            args = [*args, "--supervise"]
        return super().create_container(role, args, mounts, networks, publish)


def until(predicate, message, timeout=30):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if predicate():
            return
        time.sleep(.05)
    raise cluster.native.SmokeError(message)


def daemon(lab, node):
    return json.loads((lab.root / node / "control/daemon.json").read_text())


def pause(lab, node):
    old = daemon(lab, node)
    lab.fault(node, "pause")
    until(lambda: daemon(lab, node)["paused"] and daemon(lab, node)["pid"] == 0,
          "Daemon did not stop")
    return old


def resume(lab, node, old):
    lab.fault(node, "resume")
    until(lambda: daemon(lab, node)["generation"] > old["generation"]
          and daemon(lab, node)["pid"] > 0, "Daemon did not resume")
    lab.await_state(lambda s: all(n["reachable"] for n in s["nodes"]))


def execution(c, item):
    return next(a["execution"] for a in c.agent_snapshot(item["node"])["attempts"].values()
                if a["identity"] == item["identity"])


def snapshot_item(c, item):
    return next((k, a) for k, a in c.agent_snapshot(item["node"])["attempts"].items()
                if a["identity"] == item["identity"])


def supervise(c):
    lab = c.lab
    name = "supervised-service"
    c.submit(cluster.job(name, "service"))
    state = c.wait(name, check.ready)
    items = check.attempts(state, name)
    before = {a["node"]: execution(c, a) for a in items}
    old = pause(lab, "agent-a")
    for a in items:
        c.physical(a)
    cluster.require(len(c.launches(name)) == 2, "Unexpected service launch count")
    resume(lab, "agent-a", old)
    state = c.wait(name, check.ready)
    cluster.require({a["identity"]["attempt"] for a in check.attempts(state, name)} ==
                    {a["identity"]["attempt"] for a in items}, "Daemon crash replaced a service")
    for a in items:
        after = execution(c, a)
        cluster.require((after["pid"], after["start"]) ==
                        (before[a["node"]]["pid"], before[a["node"]]["start"]),
                        "Daemon crash changed workload process identity")
        c.physical(a)
    c.case("supervisor-daemon-sigkill-reattaches-same-process", before=before, attempts=items)

    # A fixed trusted shell fixture exits and overflows its log while daemon is absent.
    batch = cluster.job("offline-exit")
    batch["template"]["argv"] = ["/bin/sh", "-c",
        "sleep 4; i=0; while [ $i -lt 400 ]; do echo 0123456789abcdef0123456789abcdef >&2; i=$((i+1)); done; exit 7"]
    c.submit(batch)
    state = c.wait("offline-exit", lambda a: len(a) == 1 and a[0]["state"] == "running")
    item = check.attempts(state, "offline-exit")[0]
    old = pause(lab, item["node"])
    time.sleep(4.5)
    resume(lab, item["node"], old)
    state = c.wait("offline-exit", check.terminal)
    final = check.attempts(state, "offline-exit")[0]
    x = execution(c, final)
    cluster.require(final["state"] == "failed" and x["exitCode"] == 7
                    and x["stderrBytes"] == 4096 and x["stderrDropped"] == 9104,
                    "Offline exact exit/log evidence differs")
    c.case("supervisor-offline-exit-and-bounded-logs", execution=x, attempt=final)

    # Commit Stop while daemon is absent, then restart scheduler before delivery.
    old = pause(lab, "agent-a")
    c.stop(name)
    c.crash("scheduler")
    resume(lab, "agent-a", old)
    state = c.wait(name, check.terminal)
    for a in check.attempts(state, name):
        c.physical(a, available=True)
    cluster.require(len(c.launches(name)) == 2 and len(check.attempts(state, "offline-exit")) == 1,
                    "Recovery produced duplicate execution")
    c.case("supervisor-durable-stop-across-both-daemon-restarts", attempts=check.attempts(state, name))


def task_process(name, command, **extra):
    return dict(name=name, argv=["/bin/sh", "-c", command], env={}, **extra)


def task_body(name, manifest):
    body = cluster.job(name)
    body["template"]["argv"] = [cluster.BIN + "/aurora-agent", "execute-task", "--manifest-json",
                                 json.dumps(manifest, separators=(",", ":"))]
    cluster.require(len(json.dumps(body, separators=(",", ":")).encode()) <= 4096,
                    "Composed task exceeds current Job size limit")
    return body


def tasks(c):
    manifest = dict(version="task-v1alpha1", semantics="native-v1", maxConcurrency=2,
                    maxRuns=8, finalizationWaitMillis=1500, logBytes=1024, processes=[
        task_process("a", "sleep 4; echo first > order"),
        task_process("b", "test -f tried && { echo second >> order; exit 0; }; touch tried; exit 7",
                     afterSuccess=["a"], maxFailedRuns=2, restartDelayMillis=100),
        task_process("finish", "test $(wc -l < order) -eq 2 && echo finalized", finalizer=True)])
    c.submit(task_body("dag-retry", manifest))
    state = c.wait("dag-retry", lambda a: len(a) == 1 and a[0]["state"] == "running")
    item = check.attempts(state, "dag-retry")[0]
    before = execution(c, item)
    old = pause(c.lab, item["node"])
    time.sleep(4.5)
    resume(c.lab, item["node"], old)
    state = c.wait("dag-retry", check.terminal)
    final = check.attempts(state, "dag-retry")[0]
    key, public = snapshot_item(c, final)
    cluster.require(key.isalnum(), "Invalid private attempt path")
    taskdir = c.lab.root / final["node"] / "work" / key / "task-state"
    cluster.native.safe_path(taskdir)
    events = [json.loads(line) for line in (taskdir / "task.journal").read_text().splitlines()]
    exits = [e for e in events if e["kind"] == "exit"]
    result = events[-1]["result"]
    cluster.require(final["state"] == "succeeded" and public["execution"]["exitCode"] == 0
                    and public["execution"]["pid"] == before["pid"]
                    and public["execution"]["start"] == before["start"], "Task did not survive daemon loss")
    cluster.require([(e["name"], e["exitCode"]) for e in exits] ==
                    [("a", 0), ("b", 7), ("b", 0), ("finish", 0)]
                    and result["primaryResult"] == "succeeded"
                    and result["finalizationResult"] == "succeeded"
                    and result["cleanup"] == "complete", "DAG/retry/finalizer trace differs")
    c.case("task-dag-retry-finalizer-survives-daemon-sigkill", events=events, attempt=final)

    manifest["processes"] = [task_process("required", "exit 7"),
                               task_process("cleanup", "echo cleanup; exit 9", finalizer=True)]
    c.submit(task_body("failed-task", manifest))
    state = c.wait("failed-task", check.terminal)
    final = check.attempts(state, "failed-task")[0]
    key, _ = snapshot_item(c, final)
    cluster.require(key.isalnum(), "Invalid private attempt path")
    path = c.lab.root / final["node"] / "work" / key / "task-state/task.journal"
    cluster.native.safe_path(path)
    events = [json.loads(line) for line in path.read_text().splitlines()]
    result = events[-1]["result"]
    cluster.require(final["state"] == "failed" and result["primaryResult"] == "failed"
                    and result["finalizationResult"] == "failed" and result["cleanup"] == "complete",
                    "Primary and finalization outcomes differ")
    c.case("task-primary-and-finalization-results-retained", events=events)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--bundle", required=True, type=Path)
    parser.add_argument("--run-root", required=True, type=Path)
    args = parser.parse_args()
    cluster.native.safe_path(args.run_root)
    cluster.require(args.run_root.is_absolute() and not args.run_root.exists(), "Run root must be new and absolute")
    cluster.require(not args.run_root.is_relative_to(args.bundle), "Run root must be outside bundle")
    lab, c = None, None
    result = {"ok": False, "startedAt": time.time()}
    try:
        lab = ExecutionLab(args.run_root, fresh=True)
        lab.prepare(args.bundle)
        lab.start()
        c = check.Check(lab, 0, 0)
        supervise(c)
        tasks(c)
        result.update(ok=True, run=lab.data["run"], bundle=lab.data["bundle"],
                      cases=c.evidence["cases"], finalState=lab.state())
    except BaseException as error:
        result["error"] = cluster.native.redact(str(error))
    finally:
        if c is not None:
            result["cases"] = c.evidence["cases"]
        errors = []
        if lab is not None and lab.data is not None and lab.lock is not None:
            for phase in ("collect", "down", "release"):
                try:
                    getattr(lab, phase)()
                except BaseException as error:
                    errors.append(dict(phase=phase, error=cluster.native.redact(str(error))))
            result["cleanup"] = lab.data["status"]
        if errors:
            result.update(ok=False, cleanupErrors=errors)
        result["completedAt"] = time.time()
        if args.run_root.is_dir():
            cluster.save(args.run_root / "execution-result.json", result)
    print(json.dumps(result if not result["ok"] else {"ok": True, "cases": len(result["cases"]),
                     "evidence": str(args.run_root / "execution-result.json")}))
    return 0 if result["ok"] else 1


if __name__ == "__main__":
    sys.exit(main())
