from bootstrap import BuildError, get_tools, real_path, require, sha, select_java_profile, JAVA_PROFILES

HERE = Path(__file__).resolve().parent
ROOT = HERE.parents[1]


def module(name, path):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    result = importlib.util.module_from_spec(spec)
    loader.exec_module(result)
    return result


cluster = module('bundle_cluster', ROOT / 'build-support/lab/clusterctl')


def write(path, value):
    real_path(path)
    path.write_text(json.dumps(value, sort_keys=True, indent=2) + '\n')


def run(args, *, cwd=ROOT, env=None, log=None, timeout=900):
    print('+ ' + ' '.join(map(str, args)), flush=True)
    if log:
        with log.open('w') as output:
            result = subprocess.run(list(map(str, args)), cwd=cwd, env=env,
                                    stdout=output, stderr=subprocess.STDOUT, timeout=timeout)
        if result.returncode:
            print(log.read_text()[-12000:], file=sys.stderr)
            raise BuildError('Command failed; see ' + str(log))
        return ''
    result = subprocess.run(list(map(str, args)), cwd=cwd, env=env, text=True,
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=timeout)
    require(result.returncode == 0, 'Command failed: ' + result.stderr[-8000:])
    return result.stdout.strip()


def inspect(kind, identity):
    values = json.loads(run(['docker', kind, 'inspect', identity], timeout=30))
    require(isinstance(values, list) and len(values) == 1, 'Ambiguous Docker identity')
    return values[0]


class Probe:
    """Every temporary container has an immutable ID and a private ownership record."""
    def __init__(self, image_id, output, role, args=None, flags=None):
        self.token = secrets.token_hex(16)
        self.image = image_id
        self.record = output / ('probe-' + role + '.json')
        self.cidfile = output / ('probe-' + role + '.cid')
        self.id = None
        require(not self.record.exists() and not self.cidfile.exists(), 'Probe record collision')
        write(self.record, {'token': self.token, 'image': image_id, 'status': 'creating'})
        try:
            try:
                run(['docker', 'create', '--pull', 'never', '--platform', 'linux/arm64',
                     '--cidfile', self.cidfile, '--network', 'none', '--read-only', '--cap-drop', 'ALL',
                     '--security-opt', 'no-new-privileges', '--pids-limit', '128', '--cpus', '1',
                     '--label', 'com.aurora.native.probe=' + self.token,
                     *(flags or []), image_id, *(args or [])], timeout=60)
            finally:
                if self.cidfile.is_file():
                    real_path(self.cidfile)
                    identity = self.cidfile.read_text().strip()
                    require(re.fullmatch(r'[a-f0-9]{64}', identity), 'Invalid probe creation identity')
                    self.id = identity
                    write(self.record, {'token': self.token, 'image': image_id, 'id': identity, 'status': 'created'})
            require(self.id is not None, 'No probe creation identity; record preserved')
            self.verify()
        except BaseException:
            if self.id is not None:
                # Only a matching ID/image/label permits removal after ambiguous creation.
                self.close()
            raise

    def verify(self):
        item = inspect('container', self.id)
        require(item['Id'] == self.id and item['Image'] == self.image
                and item['Config']['Labels'].get('com.aurora.native.probe') == self.token,
                'Probe ownership mismatch; preserved')
        return item

    def close(self):
        self.verify()
        run(['docker', 'container', 'rm', '-f', self.id], timeout=60)
        write(self.record, {'token': self.token, 'image': self.image, 'id': self.id, 'status': 'removed'})


def payload(context, role):
    files = {}
    mappings = []
    if role.startswith('scheduler'):
        mappings += [('scheduler', '/opt/aurora')]
    if role.startswith('agent'):
        mappings += [('agent/aurora-agent', '/opt/aurora/bin/aurora-agent')]
    if role.endswith('-lab'):
        mappings += [('fixtures', '/opt/aurora/bin')]
    if role == 'tools':
        mappings += [('fixtures/cluster-helper', '/opt/aurora/bin/cluster-helper')]
    for relative, absolute in mappings:
        source = context / relative
        if source.is_file():
            files[absolute] = sha(source)
        else:
            for path in sorted(source.rglob('*')):
                require(not path.is_symlink(), 'Payload must be self-contained')
                if path.is_file():
                    files[absolute + '/' + str(path.relative_to(source))] = sha(path)
    return files


def images(output, context, pins, reports, offline):
    base = pins['baseImage']
    available = subprocess.run(['docker', 'image', 'inspect', base], stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL, timeout=30).returncode == 0
    if not available:
        require(not offline, 'Pinned base image missing in offline mode')
        run(['docker', 'pull', '--platform', pins['platform'], base], log=reports / 'base-pull.log')
    base_info = inspect('image', base)
    require(base_info['Architecture'] == 'arm64' and base_info['Os'] == 'linux', 'Base architecture mismatch')
    repository, digest = base.split('@', 1)
    repository = repository.rsplit(':', 1)[0]
    require(repository + '@' + digest in base_info.get('RepoDigests', []), 'Base repository digest mismatch')
    base_archive = output / 'pinned-base-rootfs.tar'
    base_probe = Probe(base_info['Id'], reports, 'pinned-base', ['/bin/true'])
    try:
        run(['docker', 'export', '--output', base_archive, base_probe.id])
    finally:
        base_probe.close()
    tag_prefix = 'aurora-native-local:' + secrets.token_hex(8) + '-'
    result = {}
    for role in ('scheduler', 'agent', 'scheduler-lab', 'agent-lab', 'tools'):
        parent_record = result[role[:-4]] if role.endswith('-lab') else None
        # BuildKit FROM resolves a local reference, not a bare image config ID.
        # Use this build's unique tag and verify its immutable identity around the build.
        parent = parent_record['reference'] if parent_record else base
        parent_id = parent_record['id'] if parent_record else base_info['Id']
        require(inspect('image', parent)['Id'] == parent_id, 'Parent image reference changed')
        dockerfile = 'Dockerfile.lab' if role.endswith('-lab') else 'Dockerfile.' + role
        reference = tag_prefix + role
        run(['docker', 'build', '--network', 'none', '--platform', pins['platform'], '--pull=false',
             '--label', 'com.aurora.native.role=' + role,
             '--label', 'com.aurora.native.java-profile=' + pins['java']['profile'],
             '--label', 'com.aurora.native.source=' + sha(reports / 'sources.json'),
             '--build-arg', ('RUNTIME_IMAGE=' if role.endswith('-lab') else 'BASE_IMAGE=') + parent,
             '-f', context / dockerfile, '-t', reference, context], log=reports / (role + '-build.log'))
        item = inspect('image', reference)
        expected_entry = '/opt/aurora/bin/' + ('aurora-scheduler' if role.startswith('scheduler') else
                                              'aurora-agent' if role.startswith('agent') else 'cluster-helper')
        require(item['Architecture'] == 'arm64' and item['Os'] == 'linux'
                and item['Config']['User'] == '1000:1000'
                and item['Config']['Entrypoint'] == [expected_entry]
                and not item['Config'].get('Volumes')
                and item['Config']['Labels']['com.aurora.native.role'] == role,
                'Runtime image metadata differs: ' + role)
        parent_item = inspect('image', parent)
        require(parent_item['Id'] == parent_id, 'Parent image reference changed during build')
        parent_layers = parent_item['RootFS']['Layers']
        require(item['RootFS']['Layers'][:len(parent_layers)] == parent_layers, 'Image parent layers differ')
        result[role] = {'id': item['Id'], 'reference': reference}
        write(reports / (role + '-image.json'), item)
        expected = reports / (role + '-payload.json')
        write(expected, payload(context, role))
        archive = output / (role + '-rootfs.tar')
        probe = Probe(item['Id'], reports, role)
        try:
            run(['docker', 'export', '--output', archive, probe.id])
            run([sys.executable, HERE / 'verify-image', '--java-profile', pins['java']['profile'], '--archive', archive, '--expected', expected,
                 '--base', base_archive, '--report', reports / (role + '-boundary.json')])
        finally:
            probe.close()
            if archive.is_file():
                archive.unlink()
    base_archive.unlink()
    write(reports / 'base-image.json', base_info)
    return result


def entrypoint_smokes(output, result, reports):
    probe = Probe(result['agent']['id'], reports, 'agent-entrypoint', ['version'])
    try:
        run(['docker', 'start', '-a', probe.id])
        require(probe.verify()['State']['ExitCode'] == 0, 'Packaged agent version failed')
        version = json.loads(run(['docker', 'logs', probe.id]))
        require(version['store'] == 'bbolt-v1.5.0', 'Packaged agent identity mismatch')
    finally:
        probe.close()
    config = reports / 'entrypoint-config.json'
    write(config, {'cluster': 'package-test', 'incarnation': 'one', 'nodes': [
        {'node': 'agent-a', 'journal': 'journal-a', 'boot': 'boot-a', 'runtime': 'runtime-a',
         'cpuMillis': 1000, 'memoryBytes': 536870912, 'url': 'https://agent-a:9443',
         'network': 'agent-container', 'portStart': 18080},
        {'node': 'agent-b', 'journal': 'journal-b', 'boot': 'boot-b', 'runtime': 'runtime-b',
         'cpuMillis': 1000, 'memoryBytes': 536870912, 'url': 'https://agent-b:9443',
         'network': 'agent-container', 'portStart': 18080}]})
    config.chmod(0o644)
    probe = Probe(result['scheduler']['id'], reports, 'scheduler-entrypoint',
                  ['--inspect-only', '--config', '/config.json', '--state', '/state'],
                  ['--mount', 'type=bind,src=' + str(config) + ',dst=/config.json,readonly',
                   '--tmpfs', '/state:rw,noexec,nosuid,size=32m,mode=0700,uid=1000,gid=1000',
                   '--tmpfs', '/run/aurora-native:rw,exec,nosuid,size=32m,mode=0700,uid=1000,gid=1000'])
    try:
        run(['docker', 'start', '-a', probe.id])
        require(probe.verify()['State']['ExitCode'] == 0, 'Packaged scheduler/SQLite startup failed')
        state = json.loads(run(['docker', 'logs', probe.id]))
        require(isinstance(state, dict) and state['jobs'] == [], 'Unexpected fresh packaged scheduler state')
    finally:
        probe.close()
    write(reports / 'entrypoints.json', {'ok': True, 'agent': version, 'scheduler': state})



def java_artifacts(directory):
    result = {}
    for project in ('scheduler', 'protocol'):
        for folder in ('libs', 'distributions'):
            for path in sorted((directory / project / folder).glob('*')):
                if path.is_file():
                    result[str(path.relative_to(directory))] = sha(path)
    require(len(result) == 6, 'Expected two Java JARs and four distribution archives')
    return result


def verify_java_build(directory, repeat, reports, expected_major):
    artifacts = java_artifacts(directory)
    require(artifacts == java_artifacts(repeat), 'Java artifacts differ between isolated builds')
    installed = {}
    compiled = {}
    for project, distribution in (('scheduler', 'aurora-native-scheduler'),
                                  ('protocol', 'protocol')):
        original = directory / project / 'install' / distribution
        duplicate = repeat / project / 'install' / distribution
        installed[project] = cluster.native.tree_sha(original)
        require(installed[project] == cluster.native.tree_sha(duplicate),
                'Installed Java distribution differs between isolated builds')
        for source_set in ('main', 'test'):
            files = list((directory / project / 'classes/java' / source_set).rglob('*.class'))
            require(files, 'Missing compiled Java source set: ' + project + '/' + source_set)
            for path in files:
                with path.open('rb') as stream:
                    magic, minor, major = struct.unpack('>IHH', stream.read(8))
                require(magic == 0xcafebabe and minor == 0 and major == expected_major,
                        'Unexpected Java class release: ' + str(path))
            compiled[project + '/' + source_set] = len(files)
    write(reports / 'java-reproducibility.json', {
        'ok': True, 'bytecodeMajor': expected_major, 'archives': artifacts,
        'installedTrees': installed, 'compiledClasses': compiled})


def build(args):
    require(platform.system() == 'Linux' and platform.machine() in ('aarch64', 'arm64'),
            'This pinned build profile requires a Linux ARM64 host')
    require(os.getuid() != 0, 'Build as the ordinary Docker-authorized user')
    output, cache = args.output, args.cache
    real_path(output)
    real_path(cache)
    require(not output.exists(), 'Output must be a new directory; existing bundles are preserved')
    require(not cache.is_relative_to(output), 'Cache must not be inside the new output directory')
    cache.mkdir(parents=True, exist_ok=True, mode=0o700)
    require(cache.stat().st_uid == os.getuid() and cache.stat().st_mode & 0o022 == 0,
            'Build cache must be owned by this user and not group/world writable')
    lock_path = cache / 'build.lock'
    real_path(lock_path)
    with lock_path.open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        output.mkdir(parents=True, mode=0o700)
        reports = output / 'reports'
        reports.mkdir()
        context = output / 'context'
        context.mkdir()
        work = output / 'build'
        work.mkdir()
        pins = select_java_profile(json.loads((HERE / 'toolchains.json').read_text()), args.java_profile)
        sources = cluster.source_hashes()
        write(reports / 'sources.json', sources)
        write(reports / 'toolchains.json', pins)
        tool_work = work / 'tools'
        tool_work.mkdir()
        tools = get_tools(pins, cache, tool_work, args.seed_archives, args.offline)
        env = dict(os.environ)
        env.update(JAVA_HOME=str(tools['java']), GRADLE_USER_HOME=str(cache / 'gradle'),
                   GOMODCACHE=str(cache / 'go-mod'), GOCACHE=str(cache / 'go-build'),
                   GOTOOLCHAIN='local', GOMAXPROCS='2', CGO_ENABLED='0', GOOS='linux', GOARCH='arm64',
                   GOFLAGS='-mod=readonly', GRADLE_OPTS='-Xmx256m -XX:ActiveProcessorCount=2')
        env['PATH'] = str(tools['java'] / 'bin') + ':' + str(tools['go'] / 'bin') + ':' + env['PATH']
        if args.offline:
            env.update(GOPROXY='off', GOSUMDB='off')
        versions = {}
        for role in ('java', 'runtime'):
            release = (tools[role] / 'release').read_text()
            match = re.search(r'^JAVA_VERSION="([^"]+)"$', release, re.MULTILINE)
            require(match is not None and match[1] == pins['java']['compilerRelease' if role == 'java' else 'release'].split('+')[0],
                    'Java archive release differs from selected toolchain')
            versions[role] = {'version': match[1], 'releaseSha256': sha(tools[role] / 'release'),
                              'output': run([tools[role] / 'bin/java', '--version'], env=env)}
        require(not (tools['runtime'] / 'bin/javac').exists(), 'Runtime archive contains javac')
        modules_output = run([tools['runtime'] / 'bin/java', '--list-modules'], env=env)
        modules = {line.split('@')[0] for line in modules_output.splitlines()}
        require({'java.base', 'java.sql', 'java.naming', 'jdk.httpserver', 'jdk.unsupported'} <= modules,
                'Required native scheduler runtime modules missing')
        require(not modules.intersection({'jdk.compiler', 'jdk.javadoc', 'jdk.jlink',
                                          'jdk.jpackage', 'jdk.jshell', 'jdk.jartool'}),
                'Development tool modules in runtime archive')
        versions['runtimeModules'] = sorted(modules)
        versions['compiler'] = run([tools['java'] / 'bin/javac', '--version'], env=env)
        run([tools['gradle'] / 'bin/gradle', '--version'], env=env, log=reports / 'gradle-version.log')
        write(reports / 'java-versions.json', versions)
        gradle = [tools['gradle'] / 'bin/gradle', '--no-daemon', '--max-workers=2', '--warning-mode=fail',
                  '-Dorg.gradle.java.installations.auto-detect=false',
                  '-Dorg.gradle.java.installations.auto-download=false',
                  '-Dorg.gradle.java.installations.paths=' + str(tools['java']) + ',' + str(tools['runtime']),
                  '-PnativeJavaProfile=' + args.java_profile,
                  '-Dorg.gradle.java.home=' + str(tools['java']),
                  '-Dorg.gradle.jvmargs=-Xmx256m -XX:MaxMetaspaceSize=192m -XX:ActiveProcessorCount=2 '
                  '-Dfile.encoding=UTF-8 --enable-native-access=ALL-UNNAMED']
        if args.offline:
            gradle.append('--offline')
        run([*gradle, '-p', ROOT / 'scheduler/native', '-PnativeBuildRoot=' + str(work / 'java'),
             'test', ':protocol:test', 'installDist', 'distTar', 'distZip'],
            env=env, log=reports / 'java-build.log')
        run([*gradle, '-p', ROOT / 'scheduler/native', '-PnativeBuildRoot=' + str(work / 'java'),
             ':dependencies', '--configuration', 'runtimeClasspath',
             ':protocol:dependencies', '--configuration', 'runtimeClasspath'],
            env=env, log=reports / 'java-dependencies.log')
        run([*gradle, '-p', ROOT / 'scheduler/native', '-PnativeBuildRoot=' + str(work / 'java-repro'),
             'installDist', 'distTar', 'distZip'], env=env, log=reports / 'java-repro-build.log')
        verify_java_build(work / 'java', work / 'java-repro', reports, pins['java']['bytecodeMajor'])
        scheduler = context / 'scheduler'
        scheduler.mkdir()
        shutil.copytree(tools['runtime'], scheduler / 'jre')
        shutil.copytree(work / 'java/scheduler/install/aurora-native-scheduler/lib', scheduler / 'lib')
        (scheduler / 'bin').mkdir()
        shutil.copy2(HERE / ('images/scheduler-entrypoint-java26' if pins['java']['versionMajor'] == 26 else 'images/scheduler-entrypoint'), scheduler / 'bin/aurora-scheduler')
        (scheduler / 'bin/aurora-scheduler').chmod(0o555)
        run([sys.executable, HERE / 'verify-boundary', '--lib-dir', scheduler / 'lib',
             '--java-profile', args.java_profile, '--report', reports / 'java-boundary.json'])
        go = tools['go'] / 'bin/go'
        for name, relative, target in (
                ('agent', 'agent', 'agent/aurora-agent'),
                ('cluster-helper', 'build-support/lab/fixtures/cluster-helper', 'fixtures/cluster-helper'),
                ('native-workload', 'build-support/lab/fixtures/native-workload', 'fixtures/native-workload')):
            cwd = ROOT / relative
            run([go, 'mod', 'verify'], cwd=cwd, env=env, log=reports / (name + '-modules.log'))
            run([go, 'test', '-count=1', './...'], cwd=cwd, env=env, log=reports / (name + '-test.log'))
            run([go, 'vet', './...'], cwd=cwd, env=env, log=reports / (name + '-vet.log'))
            destination = context / target
            destination.parent.mkdir(exist_ok=True)
            run([go, 'build', '-trimpath', '-buildvcs=false', '-o', destination,
                 './cmd/aurora-agent' if name == 'agent' else '.'], cwd=cwd, env=env)
            destination.chmod(0o555)
            build_info = run([go, 'version', '-m', destination], env=env)
            (reports / (name + '-build-info.txt')).write_text(build_info + '\n')
            modules = {}
            for line in build_info.splitlines():
                fields = line.split()
                require(not fields or fields[0] != '=>', 'Replaced Go dependency forbidden')
                if fields and fields[0] == 'dep':
                    require(len(fields) == 4 and fields[1] not in modules, 'Invalid Go dependency metadata')
                    modules[fields[1]] = fields[2]
                    require((fields[1] + ' ' + fields[2] + ' ' + fields[3]) in (cwd / 'go.sum').read_text().splitlines(),
                            'Go dependency checksum not in reviewed go.sum')
            require(modules == (pins['agentRuntimeModules'] if name == 'agent' else {}),
                    'Go runtime module boundary differs: ' + name)
            require('\tbuild\tCGO_ENABLED=0' in build_info and '\tbuild\tGOARCH=arm64' in build_info,
                    'Go platform/build mode differs')
        for pattern in ('test_*.py',):
            run([sys.executable, '-m', 'unittest', 'discover', '-s', HERE / 'tests', '-p', pattern],
                 log=reports / 'packaging-tests.log')
        run([sys.executable, '-m', 'unittest', 'discover', '-s', ROOT / 'build-support/lab/tests'],
             log=reports / 'lab-tests.log')
        for path in (HERE / 'images').glob('Dockerfile.*'):
            shutil.copy2(path, context / path.name)
        result = images(output, context, pins, reports, args.offline)
        entrypoint_smokes(output, result, reports)
        require(cluster.source_hashes() == sources, 'Sources changed during build; bundle not published')
        artifacts = {str(p.relative_to(output)): sha(p) for p in sorted(context.rglob('*')) if p.is_file()}
        manifest = {'schema': 1, 'architecture': 'arm64', 'sourceHashes': sources, 'images': result,
                    'artifacts': artifacts, 'hostTools': {'helper': 'context/fixtures/cluster-helper',
                    'keytool': 'context/scheduler/jre/bin/keytool', 'jre': 'context/scheduler/jre',
                    'jreSha256': cluster.native.tree_sha(scheduler / 'jre')},
                    'baseImage': pins['baseImage'], 'java': pins['java'], 'createdAt': time.time(),
                    'sourceCommit': run(['git', 'rev-parse', 'HEAD']),
                    'sourceStatus': run(['git', 'status', '--porcelain']),
                    'reports': {str(p.relative_to(output)): sha(p) for p in sorted(reports.rglob('*')) if p.is_file()}}
        write(output / 'bundle.json', manifest)
        cluster.load_bundle(output)
        print(json.dumps({'ok': True, 'bundle': str(output / 'bundle.json'), 'images': result}), flush=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--output', type=Path, required=True, help='New absolute bundle directory')
    parser.add_argument('--cache', type=Path, default=ROOT / '.cache/aurora-native')
    parser.add_argument('--seed-archives', type=Path, help='Optional checksum-verified archive download seed')
    parser.add_argument('--java-profile', choices=JAVA_PROFILES, default='java25')
    parser.add_argument('--offline', action='store_true', help='Require cached archives, modules, jars and base image')
    args = parser.parse_args()
    try:
        build(args)
    except (BuildError, cluster.native.SmokeError, OSError, ValueError, KeyError, subprocess.TimeoutExpired) as error:
        print('Native build failed: ' + str(error), file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
