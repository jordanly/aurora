# Inputs are copied by native-smoke from checkout-local verified artifacts.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG RUNTIME_UID=1000
ARG RUNTIME_GID=1000
RUN groupadd --gid ${RUNTIME_GID} aurora && useradd --uid ${RUNTIME_UID} --gid ${RUNTIME_GID} --create-home --shell /usr/sbin/nologin aurora \
 && mkdir -p /opt/aurora/bin /opt/aurora/jre /opt/aurora/lib /var/lib/aurora /evidence \
 && chown -R ${RUNTIME_UID}:${RUNTIME_GID} /opt/aurora /var/lib/aurora /evidence
COPY runtime/jre/ /opt/aurora/jre/
COPY runtime/aurora-agent /opt/aurora/bin/aurora-agent
COPY runtime/native-store-tool.jar /opt/aurora/bin/native-store-tool.jar
COPY runtime/sqlite-jdbc.jar /opt/aurora/lib/sqlite-jdbc.jar
COPY runtime/run-check /opt/aurora/bin/run-check
COPY runtime/agent-config-agent-1.json /opt/aurora/bin/agent-config-agent-1.json
COPY runtime/agent-config-agent-2.json /opt/aurora/bin/agent-config-agent-2.json
COPY runtime/delivery-agent-1.json /opt/aurora/bin/delivery-agent-1.json
COPY runtime/delivery-agent-2.json /opt/aurora/bin/delivery-agent-2.json
RUN chmod 0555 /opt/aurora/bin/* && chmod -R a+rX /opt/aurora/jre /opt/aurora/lib
USER ${RUNTIME_UID}:${RUNTIME_GID}
ENTRYPOINT ["/opt/aurora/bin/run-check"]
