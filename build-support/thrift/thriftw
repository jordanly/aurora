set -eu

if [ "$#" -lt 1 ]; then
  echo "usage: thriftw EXPECTED_THRIFT_VERSION THRIFT_ARGS..." >&2
  exit 2
fi
expected_version=$1
shift
thrift_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
compiler=$("$thrift_root/build-support/bootstrap-go" thrift)
if [ "$("$compiler" -version)" != "Thrift version $expected_version" ]; then
  echo "Requested Thrift version differs from the verified repository pin" >&2
  exit 2
fi
exec "$compiler" "$@"
