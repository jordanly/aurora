<FindBugsFilter>
  <!-- Warnings triggered in thrift-generated code. -->
  <Match>
    <Or>
      <Package name="org.apache.aurora.gen" />
      <Package name="org.apache.aurora.gen.comm" />
      <Package name="org.apache.aurora.gen.storage" />
      <Package name="org.apache.aurora.gen.test" />
      <Package name="org.apache.aurora.benchmark.generated" />
      <Package name="org.openjdk.jmh.infra.generated" />
    </Or>
    <Or>
      <Bug pattern="BC_IMPOSSIBLE_CAST" />
      <Bug pattern="CN_IDIOM" />
      <Bug pattern="DLS_DEAD_LOCAL_STORE" />
      <Bug pattern="NM_CLASS_NAMING_CONVENTION" />
      <Bug pattern="UUF_UNUSED_FIELD" />
      <Bug pattern="URF_UNREAD_FIELD" />
    </Or>
  </Match>

  <!-- We don't make use of Java serialization and this can prevent, for example, declaring an
       HttpServlet as an anonymous inner class for testing. -->
  <Match>
    <Bug pattern="SE_BAD_FIELD" />
  </Match>

  <!-- We must maintain reflexivity with WildcardPermission's equals, so we cannot override
       it even though we add fields in our subclass. We cannot use delegation because
       WildcardPermission's implies method checks that its argument is an instance of
       WildcardPermission. -->
  <Match>
    <Or>
      <Class name="org.apache.aurora.scheduler.spi.Permissions$JobScopedRpcPermission" />
      <Class name="org.apache.aurora.scheduler.spi.Permissions$UnscopedRpcPermission" />
    </Or>
    <Bug pattern="EQ_DOESNT_OVERRIDE_EQUALS" />
  </Match>

  <!-- Method is intentionally only callable by EventBus. -->
  <Match>
    <Class name="org.apache.aurora.scheduler.events.PubsubEventModule$1" />
    <Bug pattern="UMAC_UNCALLABLE_METHOD_OF_ANONYMOUS_CLASS" />
  </Match>

  <!-- Technical debt. -->
  <Match>
    <Class name="org.apache.aurora.scheduler.log.mesos.MesosLog$LogStream" />
    <Bug pattern="IS2_INCONSISTENT_SYNC" />
  </Match>
  <Match>
    <Class name="~org\.apache\.aurora.*$" />
    <Bug pattern="NP_PARAMETER_MUST_BE_NONNULL_BUT_MARKED_AS_NULLABLE" />
  </Match>
  <Match>
    <Or>
      <Class name="org.apache.aurora.scheduler.storage.backup.StorageBackup$StorageBackupImpl" />
      <Class name="org.apache.aurora.scheduler.storage.backup.StorageBackupTest" />
    </Or>
    <Bug pattern="RV_RETURN_VALUE_IGNORED_BAD_PRACTICE" />
  </Match>
  <Match>
    <Or>
      <Class name="org.apache.aurora.scheduler.app.SchedulerIT$IntPosition" />
      <Class name="org.apache.aurora.scheduler.log.mesos.MesosLog$LogStream$LogPosition" />
      <Class name="org.apache.aurora.scheduler.log.testing.FileLog$FileStream$CounterPosition" />
    </Or>
    <Bug pattern="EQ_COMPARETO_USE_OBJECT_EQUALS" />
  </Match>
  <!-- Distinct scheduled futures retain identity equality even when their remaining delays match.
       Delayed ordering intentionally does not define task identity. -->
  <Match>
    <Class name="org.apache.aurora.scheduler.testing.FakeScheduledExecutor$ScheduledWork" />
    <Bug pattern="EQ_COMPARETO_USE_OBJECT_EQUALS" />
  </Match>
  <Match>
    <Or>
      <Class name="org.apache.aurora.scheduler.cron.testing.AbstractCronIT" />
      <Class name="org.apache.aurora.scheduler.log.mesos.MesosLogTest" />
      <Class name="org.apache.aurora.scheduler.thrift.ThriftIT" />
      <Class name="org.apache.aurora.scheduler.thrift.ThriftIT$1" />
    </Or>
    <Bug pattern="DM_DEFAULT_ENCODING" />
  </Match>

  <Match>
    <!-- Options fields may be flagged as always null, since they are set reflectively. -->
    <Class name="~org.apache.aurora.scheduler.*Options" />
    <Bug pattern="UWF_NULL_FIELD" />
  </Match>

  <Match>
    <!-- FIXME: We ignore return values of guava collection builders and thus trip this warning.
         We need to wait until either https://github.com/spotbugs/spotbugs/issues/463 or
         https://github.com/google/guava/issues/2960 has been resolved -->
    <Bug pattern="RV_RETURN_VALUE_IGNORED" />
  </Match>
  <!-- Java 25 tooling compatibility only; adoption tracked in SPOTBUGS_4_MIGRATION.md.
       These four patterns are absent from the original SpotBugs 3.1.0 findbugs.xml. -->
  <Match>
    <Bug pattern="CT_CONSTRUCTOR_THROW,AT_NONATOMIC_64BIT_PRIMITIVE,JUA_DONT_ASSERT_INSTANCEOF_IN_TESTS,DCN_NULLPOINTER_EXCEPTION" />
  </Match>

  <!-- FindReturnRef in 3.1.0 checked arrays, Hashtable, util.Date, sql.Date and
       sql.Timestamp only. Defer the following newly analyzed reference types;
       leave arrays, those four classes, missing fields and unlisted types enabled.
       This is scope compatibility, not a claim that every listed type is immutable. -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2,EI_EXPOSE_STATIC_REP2,MS_EXPOSE_REP" />
    <Or>
      <Field type="com.google.common.util.concurrent.RateLimiter" />
      <Field type="java.util.List" />
      <Field type="java.util.Map" />
      <Field type="java.util.Set" />
      <Field type="java.util.concurrent.ScheduledThreadPoolExecutor" />
      <Field type="java.util.concurrent.atomic.AtomicInteger" />
      <Field type="org.apache.aurora.gen.storage.LogEntry" />
      <Field type="org.apache.aurora.scheduler.BatchWorker" />
      <Field type="org.apache.aurora.scheduler.SchedulerModule$TaskEventBatchWorker" />
      <Field type="org.apache.aurora.scheduler.offers.OfferManager" />
      <Field type="org.apache.aurora.scheduler.offers.OfferSet" />
      <Field type="org.apache.aurora.scheduler.sla.SlaManager" />
      <Field type="org.apache.aurora.scheduler.state.StateManager" />
      <Field type="org.apache.aurora.scheduler.storage.AttributeStore$Mutable" />
      <Field type="org.apache.aurora.scheduler.storage.CronJobStore$Mutable" />
      <Field type="org.apache.aurora.scheduler.storage.HostMaintenanceStore$Mutable" />
      <Field type="org.apache.aurora.scheduler.storage.JobUpdateStore$Mutable" />
      <Field type="org.apache.aurora.scheduler.storage.QuotaStore$Mutable" />
      <Field type="org.apache.aurora.scheduler.storage.Storage" />
      <Field type="org.apache.aurora.scheduler.storage.TaskStore$Mutable" />
      <Field type="org.apache.aurora.scheduler.storage.sqlite.SqliteAttributeStore" />
      <Field type="org.apache.aurora.scheduler.storage.sqlite.SqliteCronJobStore" />
      <Field type="org.apache.aurora.scheduler.storage.sqlite.SqliteEffects" />
      <Field type="org.apache.aurora.scheduler.storage.sqlite.SqliteHostMaintenanceStore" />
      <Field type="org.apache.aurora.scheduler.storage.sqlite.SqliteJobUpdateStore" />
      <Field type="org.apache.aurora.scheduler.storage.sqlite.SqliteQuotaStore" />
      <Field type="org.apache.aurora.scheduler.storage.sqlite.SqliteTaskStore" />
      <Field type="org.apache.mesos.v1.Protos$ExecutorInfo" />
      <Field type="org.apache.mesos.v1.Protos$FrameworkInfo" />
      <Field type="org.apache.mesos.v1.Protos$Offer" />
      <Field type="org.apache.mesos.v1.Protos$TaskInfo" />
      <Field type="org.apache.mesos.v1.Protos$TaskStatus" />
    </Or>
  </Match>
</FindBugsFilter>
